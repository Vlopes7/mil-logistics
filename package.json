{
  "name": "mil-logistics",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm run server:install",
    "install:all:laya": "npm run install:all && npm run server:install:laya",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "python -m uvicorn app.main:app --app-dir server --reload --host 0.0.0.0 --port 8000",
    "dev:web": "npm run dev --workspace frontend",
    "seed": "python server/scripts/seed.py",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace frontend && npm run test:api",
    "test:frontend": "npm run test --workspace frontend",
    "test:api": "python -m pytest server/tests",
    "server:install": "python -m pip install -r server/requirements.txt",
    "server:install:laya": "python -m pip install laya",
    "server:venv": "python -m venv server/.venv",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7"
  }
}
